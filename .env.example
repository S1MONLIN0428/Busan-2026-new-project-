# Copy to .env for local development. On Koyeb, set these as environment
# variables on the service instead (see DEPLOY.md).

# Neon connection string. Looks like:
#   postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Get it from the Neon dashboard -> your project -> Connect.
DATABASE_URL=

# Optional. Port to listen on. Koyeb sets this automatically; leave blank locally.
PORT=8000
